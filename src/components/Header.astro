---
import { siteConfig } from '../data/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#top" aria-label="Ir al inicio de HCB Studio">
      <span class="brand-wordmark"><span class="gold">{siteConfig.brand.shortName}</span> Studio</span>
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      {siteConfig.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="btn btn-primary site-header__cta" href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">
      Reservar
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(21, 17, 15, 0.82);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.4rem;
  }

  .site-header__brand {
    flex-shrink: 0;
    font-size: 1.15rem;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
  }

  .site-header__nav a {
    color: rgba(244, 238, 231, 0.78);
    font-weight: 700;
    transition: color 180ms ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--text);
  }

  .site-header__cta {
    padding-inline: 1.4rem;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0.75rem 0;
    }

    .site-header__nav {
      order: 3;
      width: 100%;
      gap: 1rem 1.25rem;
      padding-bottom: 0.25rem;
      overflow-x: auto;
      justify-content: flex-start;
    }
  }
</style>
