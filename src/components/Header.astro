---
import { siteConfig } from '../data/site';
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="site-header__brand" href="#top" aria-label="Ir al inicio de HCB Studio">
      <img
        class="site-header__logo"
        src={siteConfig.brand.logo.src}
        alt={siteConfig.brand.logo.alt}
        width={siteConfig.brand.logo.width}
        height={siteConfig.brand.logo.height}
        loading="eager"
        decoding="async"
      />
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      {siteConfig.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="btn btn-primary site-header__cta" href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">
      Reservar
    </a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(21, 17, 15, 0.82);
    backdrop-filter: blur(18px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 5.4rem;
  }

  .site-header__brand {
    flex-shrink: 0;
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .site-header__logo {
    width: auto;
    height: 56px;
    max-width: min(280px, 48vw);
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.75rem;
    flex: 1 1 auto;
  }

  .site-header__nav a {
    color: rgba(244, 238, 231, 0.78);
    font-weight: 700;
    transition: color 180ms ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--text);
  }

  .site-header__cta {
    padding-inline: 1.4rem;
  }

  @media (max-width: 900px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 1rem 1.25rem;
      padding: 0.9rem 0 1rem;
    }

    .site-header__cta {
      justify-self: end;
    }

    .site-header__nav {
      grid-column: 1 / -1;
      width: 100%;
      gap: 1rem 1.25rem;
      padding-top: 0.25rem;
      justify-content: center;
    }
  }

  @media (max-width: 520px) {
    .site-header__inner {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: 0.85rem;
    }

    .site-header__brand,
    .site-header__cta {
      justify-self: center;
    }

    .site-header__logo {
      height: 46px;
      max-width: 200px;
    }

    .site-header__nav {
      gap: 0.8rem 1.5rem;
      padding-top: 0;
    }

    .site-header__nav a {
      font-size: 0.95rem;
    }

    .site-header__cta {
      width: min(100%, 15rem);
      padding-inline: 1.2rem;
    }
  }
</style>
