---
import { siteConfig } from '../data/site';
---

<header class="site-header">
  <div class="container site-header__inner">

    <a class="site-header__brand" href="#top" aria-label="Ir al inicio de HCB Studio">
      <img
        class="site-header__logo"
        src={siteConfig.brand.logo.src}
        alt={siteConfig.brand.logo.alt}
        width="160"
        height="160"
        loading="eager"
        decoding="async"
      />
    </a>

    <div class="site-header__right">
      <a class="btn btn-primary site-header__cta" href={siteConfig.bookingUrl} target="_blank" rel="noreferrer">
        Reservar
      </a>

      <button class="site-header__hamburger" aria-label="Abrir menú" aria-expanded="false" aria-controls="site-nav">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <!-- Nav dropdown (always behind hamburger) -->
  <nav class="site-header__nav" id="site-nav" aria-label="Principal">
    <div class="container site-header__nav-inner">
      {siteConfig.nav.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>
  </nav>
</header>

<script>
  const header = document.querySelector('.site-header') as HTMLElement;
  const btn = document.querySelector('.site-header__hamburger') as HTMLButtonElement;
  const nav = document.querySelector('.site-header__nav') as HTMLElement;

  btn?.addEventListener('click', () => {
    const isOpen = header?.hasAttribute('data-open');
    header?.toggleAttribute('data-open');
    btn?.setAttribute('aria-expanded', isOpen ? 'false' : 'true');
  });

  // Close on nav link click
  nav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => {
      header?.removeAttribute('data-open');
      btn?.setAttribute('aria-expanded', 'false');
    });
  });

  // Close on outside click
  document.addEventListener('click', (e) => {
    if (!header?.contains(e.target as Node)) {
      header?.removeAttribute('data-open');
      btn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(21, 17, 15, 0.88);
    backdrop-filter: blur(20px);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.2rem;
  }

  /* Logo */
  .site-header__brand {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .site-header__logo {
    width: auto;
    height: 48px;
  }

  /* Right side: CTA + hamburger */
  .site-header__right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .site-header__cta {
    padding: 0.7rem 1.3rem;
    font-size: 0.84rem;
  }

  /* Hamburger */
  .site-header__hamburger {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 2.6rem;
    height: 2.6rem;
    padding: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.6rem;
    background: rgba(255, 255, 255, 0.04);
    cursor: pointer;
    flex-shrink: 0;
  }

  .site-header__hamburger span {
    display: block;
    height: 1.5px;
    background: var(--text);
    border-radius: 2px;
    transition: transform 240ms ease, opacity 240ms ease;
    transform-origin: center;
  }

  /* Hamburger → X when open */
  .site-header[data-open] .site-header__hamburger span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .site-header[data-open] .site-header__hamburger span:nth-child(2) {
    opacity: 0;
  }
  .site-header[data-open] .site-header__hamburger span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }

  /* Nav dropdown — hidden by default */
  .site-header__nav {
    overflow: hidden;
    max-height: 0;
    border-top: 0px solid rgba(255, 255, 255, 0.06);
    transition: max-height 280ms ease, border-top-width 280ms ease;
    background: rgba(18, 15, 13, 0.96);
  }

  /* Nav open */
  .site-header[data-open] .site-header__nav {
    max-height: 28rem;
    border-top-width: 1px;
  }

  .site-header__nav-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    padding: 0.5rem 0 0.75rem;
  }

  .site-header__nav a {
    display: block;
    padding: 0.65rem 1rem;
    color: rgba(244, 238, 231, 0.72);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    border-radius: 0.5rem;
    transition: color 160ms ease, background 160ms ease;
  }

  .site-header__nav a:hover,
  .site-header__nav a:focus-visible {
    color: var(--gold-soft);
    background: rgba(217, 161, 45, 0.07);
  }

  @media (max-width: 520px) {
    .site-header__nav-inner {
      flex-direction: column;
      gap: 0;
    }

    .site-header__nav a {
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      border-radius: 0;
      padding: 0.75rem 0;
    }

    .site-header__cta {
      padding: 0.65rem 1rem;
      font-size: 0.78rem;
    }

    .site-header__logo {
      height: 40px;
    }
  }
</style>
