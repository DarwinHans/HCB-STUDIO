---
import { siteConfig } from '../data/site';
---

<section id="nosotros">
  <div class="about__backdrop" aria-hidden="true"></div>
  <div class="container about">
    <div class="about__intro">
      <div class="about__index">
        <span class="about__index-number">/ 01</span>
        <span class="about__index-line"></span>
      </div>

      <h2>{siteConfig.about.title}</h2>

      <div class="about__kicker-wrap">
        <span class="about__kicker-line"></span>
        <p class="about__kicker">{siteConfig.about.kicker}</p>
      </div>

      <p class="about__lead">{siteConfig.about.lead}</p>
    </div>

    <div class="about__content">
      <div class="about__columns">
        {siteConfig.about.paragraphs.map((paragraph, index) => (
          <article class="about__panel">
            <span class="about__panel-label">0{index + 1}</span>
            <p>{paragraph}</p>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #nosotros {
    isolation: isolate;
    overflow: hidden;
    padding: 7rem 0;
    background: #120e0c;
  }

  .about__backdrop {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(10, 8, 7, 0.82) 0%, rgba(10, 8, 7, 0.68) 38%, rgba(10, 8, 7, 0.74) 100%),
      linear-gradient(180deg, rgba(8, 7, 6, 0.18) 0%, rgba(8, 7, 6, 0.62) 100%),
      url('https://images.unsplash.com/photo-1621605815971-fbc98d665033?auto=format&fit=crop&w=1800&q=80');
    background-position: center;
    background-size: cover;
    transform: scale(1.03);
  }

  .about {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr);
    gap: clamp(2.25rem, 4vw, 4.75rem);
    align-items: start;
  }

  .about__intro {
    display: grid;
    gap: 1.5rem;
    padding-top: 0.55rem;
    min-width: 0;
  }

  .about__index {
    display: flex;
    align-items: center;
    gap: 1rem;
    color: rgba(244, 238, 231, 0.72);
  }

  .about__index-number {
    font-size: 0.86rem;
    font-weight: 700;
    letter-spacing: 0.22rem;
    text-transform: uppercase;
  }

  .about__index-line {
    width: 3.8rem;
    height: 1px;
    background: rgba(244, 238, 231, 0.32);
  }

  .about__intro h2 {
    font-size: clamp(3.8rem, 7.4vw, 6rem);
    line-height: 0.88;
    color: #f7f0e8;
    text-transform: uppercase;
  }

  .about__kicker-wrap {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .about__kicker-line {
    width: 3.6rem;
    height: 2px;
    background: linear-gradient(90deg, var(--gold), rgba(240, 193, 82, 0.15));
  }

  .about__kicker {
    color: rgba(244, 238, 231, 0.68);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.42rem;
    text-transform: uppercase;
  }

  .about__content {
    display: grid;
    min-width: 0;
    padding-top: clamp(1rem, 5vw, 4rem);
    align-content: start;
  }

  .about__lead {
    color: #e3a82d;
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    font-style: italic;
    font-weight: 700;
    line-height: 1.35;
    text-wrap: balance;
    text-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
    margin-top: 0.5rem;
  }

  .about__columns {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .about__panel {
    display: grid;
    grid-template-columns: 2.8rem 1fr;
    gap: 1.4rem;
    align-items: baseline;
    padding: 1.6rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  .about__panel-label {
    color: var(--gold);
    font-size: 0.76rem;
    font-weight: 800;
    letter-spacing: 0.2rem;
    padding-top: 0.18rem;
  }

  .about__panel p {
    color: rgba(244, 238, 231, 0.72);
    font-size: 1.02rem;
    line-height: 1.85;
  }

  @media (max-width: 1080px) {
    .about {
      grid-template-columns: 1fr;
    }

    .about__content {
      padding-top: 0;
    }

    .about__lead {
      max-width: 100%;
    }

  }


  @media (max-width: 900px) {
    #nosotros {
      padding: 5.2rem 0;
    }
  }

  @media (max-width: 560px) {
    .about__intro h2 {
      font-size: clamp(2.2rem, 15vw, 4.6rem);
    }

    .about__kicker {
      letter-spacing: 0.28rem;
      line-height: 1.5;
    }

    .about__panel {
      padding: 1.35rem 1.2rem 1.45rem;
    }

    .about__panel p {
      font-size: 0.98rem;
      line-height: 1.72;
    }
  }
</style>
