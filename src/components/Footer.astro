---
import { siteConfig } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div>
      <p class="brand-wordmark"><span class="gold">{siteConfig.brand.shortName}</span> Studio</p>
      <p>{siteConfig.brand.tagline}, Chile</p>
    </div>
    <p>© {currentYear} HCB Studio. Todos los derechos reservados.</p>
  </div>
</footer>

<style>
  .site-footer {
    padding: 2.5rem 0 3rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
  }

  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
  }
</style>
