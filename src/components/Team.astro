---
import { siteConfig } from '../data/site';
---

<section id="equipo">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{siteConfig.team.kicker}</p>
      <h2>
        Profesionales de <span class="gold">Elite</span>
      </h2>
    </div>

    <div class="team-grid">
      {siteConfig.team.members.map((member) => (
        <article class="card team-card">
          <img src={member.image} alt={member.name} loading="lazy" width="720" height="900" />
          <div class="team-card__body">
            <h3>{member.name}</h3>
            <p class="team-card__role">{member.role}</p>
            <p>{member.bio}</p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem;
  }

  .team-card {
    overflow: hidden;
  }

  .team-card img {
    aspect-ratio: 0.85;
    width: 100%;
    object-fit: cover;
  }

  .team-card__body {
    padding: 1.8rem;
  }

  .team-card__role {
    margin: 0.35rem 0 1rem;
    color: var(--gold);
    font-size: 0.95rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .team-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
