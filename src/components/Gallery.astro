---
import { siteConfig } from '../data/site';
---

<section id="galeria">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{siteConfig.gallery.kicker}</p>
      <h2>{siteConfig.gallery.title}</h2>
    </div>

    <div class="gallery-grid">
      {siteConfig.gallery.images.map((item, index) => (
        <figure class:list={['gallery-item', `gallery-item--${index + 1}`]}>
          {item.type === 'video' ? (
            <video
              data-src={item.src}
              preload="none"
              muted
              loop
              playsinline
              aria-label={item.alt}
              width="900"
              height="1200"
              class="gallery-video"
            />
          ) : (
            <img src={item.src} alt={item.alt} loading="lazy" width="900" height="1200" />
          )}
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  const videos = document.querySelectorAll<HTMLVideoElement>('video.gallery-video');
  if (videos.length > 0 && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;
          if (entry.isIntersecting) {
            if (!video.src && video.dataset.src) {
              video.src = video.dataset.src;
            }
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { rootMargin: '200px 0px', threshold: 0.1 }
    );
    videos.forEach((v) => io.observe(v));
  }
</script>

<style>
  .gallery-grid {
    display: grid;
    grid-template-columns: 1.55fr 0.75fr 0.75fr;
    grid-template-rows: repeat(3, minmax(220px, 360px));
    gap: 1rem;
  }

  .gallery-item {
    margin: 0;
    overflow: hidden;
    border-radius: 1.4rem;
    border: 1px solid var(--line);
    box-shadow: var(--shadow);
  }

  .gallery-item img,
  .gallery-item video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.85) contrast(1.1) saturate(0.65) sepia(0.18);
    transition: transform 280ms ease, filter 280ms ease;
  }

  .gallery-item:hover img,
  .gallery-item:hover video {
    transform: scale(1.03);
    filter: brightness(0.92) contrast(1.08) saturate(0.8) sepia(0.12);
  }

  /* item 1: tall, spans rows 1–2 */
  .gallery-item--1 {
    grid-row: 1 / span 2;
  }

  /* item 4: wide, spans cols 2–3 en fila 2 */
  .gallery-item--4 {
    grid-column: 2 / span 2;
  }

  /* items 5–7: fila 3 normal */

  @media (max-width: 900px) {
    .gallery-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: none;
    }

    .gallery-item--1 {
      grid-column: 1 / span 2;
      grid-row: auto;
    }

    .gallery-item--4 {
      grid-column: auto;
    }

    .gallery-item img,
    .gallery-item video {
      aspect-ratio: 1.05;
    }
  }

  @media (max-width: 560px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }

    .gallery-item--1 {
      grid-column: auto;
    }
  }
</style>
