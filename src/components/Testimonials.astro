---
import { siteConfig } from '../data/site';
---

<section id="testimonios">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow">{siteConfig.testimonials.kicker}</p>
      <h2>{siteConfig.testimonials.title}</h2>
    </div>

    <div class="testimonials-grid">
      {siteConfig.testimonials.items.map((item) => (
        <article class="card testimonial-card">
          <div class="testimonial-card__stars" aria-hidden="true">★★★★★</div>
          <p class="testimonial-card__quote">"{item.quote}"</p>
          <strong class="testimonial-card__author">{item.author}</strong>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.4rem;
  }

  .testimonial-card {
    min-height: 15rem;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: 1.75rem;
  }

  .testimonial-card__stars {
    color: var(--gold);
    letter-spacing: 0.2rem;
  }

  .testimonial-card__quote {
    color: var(--text);
    font-style: italic;
  }

  .testimonial-card__author {
    margin-top: auto;
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.55rem;
  }

  @media (max-width: 900px) {
    .testimonials-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
